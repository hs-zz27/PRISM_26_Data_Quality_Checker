# Copy this file to .env and set your own password before starting PostgreSQL.
POSTGRES_USER=prism
# Single-quote passwords containing dollar signs or # to preserve literal text.
POSTGRES_PASSWORD=
POSTGRES_DB=prism
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Optional PostgreSQL connection URL; overrides POSTGRES_* for the backend only.
# DATABASE_URL=

# Optional local overrides; leave commented to use backend/ollama.toml defaults.
# The model must already be installed. Use a full URL for the running server.
# OLLAMA_MODEL=qwen3-vl:4b-instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional project CPU thread override; auto is the portable default.
# OLLAMA_CPU_THREADS=auto
# Ten threads was benchmarked only on the maintainer's M4 MacBook Air with the 4B model.
# Benchmark your machine before using OLLAMA_CPU_THREADS=10; see backend/README.md.
# Changing the URL here does not change Ollama's listening port.

# Optional hard limit for one sample's processing time (seconds, 1-86400).
# AUDIT_SAMPLE_MAX_SECONDS=900

# Optional private root for immutable source-asset snapshots.
# ASSET_STORAGE_ROOT=/absolute/path/to/private/assets

# Optional dataset import storage; must be disjoint from ASSET_STORAGE_ROOT.
# DATASET_IMPORT_ROOT=/absolute/path/to/private/imports
# Resource policies, not dataset quality thresholds. Byte limits are measured.
# DATASET_IMPORT_MAX_ARCHIVE_BYTES=536870912
# DATASET_IMPORT_MAX_EXPANDED_BYTES=2147483648
# DATASET_IMPORT_MAX_SAMPLES=3000
# DATASET_IMPORT_MAX_SECONDS=900
# Optional multipart overhead/spooling limits (bytes).
# DATASET_HTTP_OVERHEAD_BYTES=65536
# DATASET_HTTP_SPOOL_BYTES=1048576

# Reviewed exports: server-only private storage and resource limits.
# EXPORT_ROOT defaults to the absolute backend/data/exports directory.
# If overriding, use an absolute owner-only directory disjoint from assets/imports.
# EXPORT_ROOT=/absolute/private/backend/data/exports
EXPORT_MAX_FILE_BYTES=67108864
EXPORT_MAX_INPUT_BYTES=2147483648
EXPORT_MAX_ARCHIVE_BYTES=2147483648
EXPORT_MAX_SAMPLES=3000
EXPORT_MAX_METADATA_BYTES=16777216
EXPORT_MAX_SECONDS=900
EXPORT_LEASE_SECONDS=30
EXPORT_POLL_SECONDS=1

# Optional correction/recheck policy, loaded at request time. Bytes, not MiB.
# Mask/annotation byte limits must not exceed CORRECTION_MAX_ASSET_BYTES.
# CORRECTION_MAX_MASK_BYTES=16777216
# CORRECTION_MAX_ASSET_BYTES=67108864
# CORRECTION_MAX_ANNOTATION_BYTES=2097152
# CORRECTION_MAX_PIXELS=16000000
# CORRECTION_UPLOAD_TTL_SECONDS=3600

# Optional person detection for NEW audits; off unless DETECTION_ENABLED=true.
# These settings are frozen into each audit when it is accepted. The audit worker
# reads the checkpoint location and refuses a file whose SHA-256 differs from the
# frozen value. Nothing is downloaded by the application. Choose thresholds
# deliberately; there are no defaults. See backend/CPU_DETECTION.md.
# DETECTION_ENABLED=true
# DETECTION_CHECKPOINT_PATH=/absolute/path/to/fasterrcnn_mobilenet_v3_large_320_fpn-907ea3f9.pth
# DETECTION_CHECKPOINT_SHA256=<64 lowercase hexadecimal characters>
# DETECTION_PERSON_LABELS=<comma-separated annotation labels that mean person>
# DETECTION_MIN_CONFIDENCE=<number from 0 to 1>
# DETECTION_MIN_IOU=<number greater than 0 and at most 1>

# Reviewed feedback: canonical digest of the owner's separately installed LOCAL vision model.
# Obtain it in an explicitly authorized /api/tags check; a mutable model tag is insufficient.
# Existing OLLAMA_MODEL / OLLAMA_BASE_URL and backend/ollama.toml still apply.
# Omission keeps model checks unavailable; deterministic-only audits are unaffected.
# FEEDBACK_MODEL_DIGEST=sha256:<64-lowercase-hex-digest>

# Optional pedestrian enclosure proposals for snapshot audits. No model download.
# Rechecks preserve the parent's enabled OR disabled choice. See backend/ENCLOSURE_CHECK.md.
ENCLOSURE_ENABLED=false
# ENCLOSURE_MODEL=qwen3-vl:4b-instruct
# ENCLOSURE_MODEL_DIGEST=sha256:<64-lowercase-hex-digest>
# Required when enabled; leave at least 30 seconds below AUDIT_SAMPLE_MAX_SECONDS.
# ENCLOSURE_SAMPLE_BUDGET_SECONDS=840
# ENCLOSURE_HOST=http://127.0.0.1:11434
# ENCLOSURE_NUM_CTX=16384
# ENCLOSURE_NUM_PREDICT=2048
# Leave threads unset for automatic selection; 10 was measured on the owner's M4 Air only.
# ENCLOSURE_NUM_THREAD=10
# ENCLOSURE_REQUEST_TIMEOUT_SECONDS=600
# ENCLOSURE_MAX_BOXES=12
# ENCLOSURE_MAX_REQUEST_BYTES=67108864
# ENCLOSURE_MAX_RESPONSE_BYTES=65536
# ENCLOSURE_KEEP_ALIVE_SECONDS=300

# Docker Compose starts PostgreSQL, migrations, API, frontend and all five workers.
# See docker/README.md. Run Compose from the repository root.
# API_PORT=8000
# FRONTEND_PORT=5173
# COMPOSE_STOP_GRACE_PERIOD=16m
# Optional CPU detector: mount the directory containing your existing checkpoint.
# DETECTION_MODEL_ROOT=/absolute/path/to/model-directory
# COMPOSE_DETECTION_CHECKPOINT_PATH=/models/checkpoint.pth
# Keep DETECTION_ENABLED and the digest/threshold settings above explicit.
# Compose alone enables CDIF_ALLOW_DOCKER_OLLAMA=1 and uses host.docker.internal.
# Native execution remains loopback-only; do not set that flag for native runs.
