# Copy this file to .env and set your own password before starting PostgreSQL.
POSTGRES_USER=prism
# Single-quote passwords containing dollar signs or # to preserve literal text.
POSTGRES_PASSWORD=
POSTGRES_DB=prism
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Optional PostgreSQL connection URL; overrides POSTGRES_* for the backend only.
# DATABASE_URL=

# Optional local overrides; leave commented to use backend/ollama.toml defaults.
# The model must already be installed. Use a full URL for the running server.
# OLLAMA_MODEL=qwen3-vl:4b-instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Changing the URL here does not change Ollama's listening port.

# Optional hard limit for one sample's processing time (seconds, 1-86400).
# AUDIT_SAMPLE_MAX_SECONDS=900

# Optional private root for immutable source-asset snapshots.
# ASSET_STORAGE_ROOT=/absolute/path/to/private/assets

# Optional dataset import storage; must be disjoint from ASSET_STORAGE_ROOT.
# DATASET_IMPORT_ROOT=/absolute/path/to/private/imports
# Resource policies, not dataset quality thresholds. Byte limits are measured.
# DATASET_IMPORT_MAX_ARCHIVE_BYTES=536870912
# DATASET_IMPORT_MAX_EXPANDED_BYTES=2147483648
# DATASET_IMPORT_MAX_SAMPLES=3000
# DATASET_IMPORT_MAX_SECONDS=900
# Optional multipart overhead/spooling limits (bytes).
# DATASET_HTTP_OVERHEAD_BYTES=65536
# DATASET_HTTP_SPOOL_BYTES=1048576

# Reviewed exports: server-only private storage and resource limits.
# EXPORT_ROOT defaults to the absolute backend/data/exports directory.
# If overriding, use an absolute owner-only directory disjoint from assets/imports.
# EXPORT_ROOT=/absolute/private/backend/data/exports
EXPORT_MAX_FILE_BYTES=67108864
EXPORT_MAX_INPUT_BYTES=2147483648
EXPORT_MAX_ARCHIVE_BYTES=2147483648
EXPORT_MAX_SAMPLES=3000
EXPORT_MAX_METADATA_BYTES=16777216
EXPORT_MAX_SECONDS=900
EXPORT_LEASE_SECONDS=30
EXPORT_POLL_SECONDS=1
